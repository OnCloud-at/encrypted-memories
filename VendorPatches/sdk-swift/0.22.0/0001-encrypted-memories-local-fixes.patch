new file mode 100644
index 0000000000000000000000000000000000000000..e5dab3aeccf4a990b7de582e0fbee7ffa9715558
--- /dev/null
+++ b/Tests/BoxedDownloadStreamTests.swift
@@ -0,0 +1,57 @@
+import Foundation
+import Testing
+@testable import ProtonDriveSDK
+
+@Suite("Download stream boundaries")
+struct BoxedDownloadStreamTests {
+    @Test(arguments: [0, 7, 8, 9, 16, 17])
+    func asyncBytesPreserveEveryByteAndReportExactEOF(length: Int) async throws {
+        let expected = Data((0 ..< length).map { UInt8($0 % 251) })
+        let stream = AsyncStream<UInt8> { continuation in
+            for byte in expected { continuation.yield(byte) }
+            continuation.finish()
+        }
+        let reader = AsyncBytesDownloadStream(stream: AnyAsyncSequence(stream))
+        var received = Data()
+
+        while true {
+            let result = try await reader.read(upTo: 8)
+            received.append(result.data)
+            if result.reachedEnd { break }
+        }
+
+        #expect(received == expected)
+    }
+
+    @Test func lookaheadErrorDoesNotDiscardTheFullBuffer() async throws {
+        struct ExpectedFailure: Error {}
+        let stream = AsyncThrowingStream<UInt8, any Error> { continuation in
+            for byte in UInt8(0) ..< UInt8(8) { continuation.yield(byte) }
+            continuation.finish(throwing: ExpectedFailure())
+        }
+        let reader = AsyncBytesDownloadStream(stream: AnyAsyncSequence(stream))
+
+        let fullBuffer = try await reader.read(upTo: 8)
+        #expect(fullBuffer.data == Data((0 ..< 8).map(UInt8.init)))
+        #expect(!fullBuffer.reachedEnd)
+        await #expect(throws: ExpectedFailure.self) {
+            _ = try await reader.read(upTo: 8)
+        }
+    }
+
+    @Test func exactSizeFileReportsEOFWithoutMutatingInitialOffset() async throws {
+        let url = FileManager.default.temporaryDirectory
+            .appendingPathComponent("ProtonDriveSDK-\(UUID().uuidString).bin")
+        defer { try? FileManager.default.removeItem(at: url) }
+        try Data((0 ..< 8).map(UInt8.init)).write(to: url)
+        let handle = try FileHandle(forReadingFrom: url)
+        try handle.seek(toOffset: 3)
+
+        let reader = FileHandleDownloadStream(fileHandle: handle)
+        #expect(try handle.offset() == 3)
+        let result = try await reader.read(upTo: 5)
+
+        #expect(result.data == Data((3 ..< 8).map(UInt8.init)))
+        #expect(result.reachedEnd)
+    }
+}
diff --git a/Tests/CallbackHandleRegistryTests.swift b/Tests/CallbackHandleRegistryTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..68ae8f14114f6ae30df4bfa5f4e3e9dccf5ccb6b
--- /dev/null
+++ b/Tests/CallbackHandleRegistryTests.swift
@@ -0,0 +1,72 @@
+import Foundation
+import Testing
+@testable import ProtonDriveSDK
+
+@Suite("Callback registry cancellation")
+struct CallbackHandleRegistryTests {
+    @Test func cancellationRemovesHandleAndResumesExactlyOnce() {
+        let recorder = CompletionRecorder()
+        let box = BoxedCompletionBlock<Void, Void>({ recorder.record($0) }, state: ())
+        let handle = CallbackHandleRegistry.shared.register(box)
+        box.registryHandleId = handle
+
+        CallbackHandleRegistry.shared.cancel(handle)
+        CallbackHandleRegistry.shared.cancel(handle)
+
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+        #expect(recorder.count == 1)
+        #expect(recorder.wasCancelled)
+        #expect(CallbackHandleRegistry.shared.get(handle, as: BoxedCompletionBlock<Void, Void>.self) == nil,
+                "a late yield/terminal callback must become a no-op")
+    }
+
+    @Test func cancellationAndTerminalCompletionRaceStillResumeOnce() async {
+        let recorder = CompletionRecorder()
+        let box = BoxedCompletionBlock<Void, Void>({ recorder.record($0) }, state: ())
+        let handle = CallbackHandleRegistry.shared.register(box)
+        box.registryHandleId = handle
+
+        await withTaskGroup(of: Void.self) { group in
+            group.addTask { CallbackHandleRegistry.shared.cancel(handle) }
+            group.addTask {
+                (CallbackHandleRegistry.shared.remove(handle) as? BoxedCompletionBlock<Void, Void>)?
+                    .resume(returning: ())
+            }
+        }
+
+        #expect(recorder.count == 1)
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+    }
+
+    @Test func cancellationBeforeHandleInstallationCancelsTheLateRegistration() {
+        let recorder = CompletionRecorder()
+        let box = BoxedCompletionBlock<Void, Void>({ recorder.record($0) }, state: ())
+        let handle = CallbackHandleRegistry.shared.register(box)
+        box.registryHandleId = handle
+        let cancellation = SDKRequestHandler.RequestCancellation()
+
+        cancellation.cancel()
+        cancellation.install(handle)
+
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+        #expect(recorder.count == 1)
+        #expect(recorder.wasCancelled)
+    }
+}
+
+private final class CompletionRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var results: [Result<Void, Error>] = []
+
+    func record(_ result: Result<Void, Error>) {
+        lock.withLock { results.append(result) }
+    }
+
+    var count: Int { lock.withLock { results.count } }
+    var wasCancelled: Bool {
+        lock.withLock {
+            guard case let .failure(error)? = results.first else { return false }
+            return error is CancellationError
+        }
+    }
+}
