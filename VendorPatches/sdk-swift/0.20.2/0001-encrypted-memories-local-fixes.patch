+++ b/Tests/BoxedDownloadStreamTests.swift
@@ -0,0 +1,57 @@
+import Foundation
+import Testing
+@testable import ProtonDriveSDK
+
+@Suite("Download stream boundaries")
+struct BoxedDownloadStreamTests {
+    @Test(arguments: [0, 7, 8, 9, 16, 17])
+    func asyncBytesPreserveEveryByteAndReportExactEOF(length: Int) async throws {
+        let expected = Data((0 ..< length).map { UInt8($0 % 251) })
+        let stream = AsyncStream<UInt8> { continuation in
+            for byte in expected { continuation.yield(byte) }
+            continuation.finish()
+        }
+        let reader = AsyncBytesDownloadStream(stream: AnyAsyncSequence(stream))
+        var received = Data()
+
+        while true {
+            let result = try await reader.read(upTo: 8)
+            received.append(result.data)
+            if result.reachedEnd { break }
+        }
+
+        #expect(received == expected)
+    }
+
+    @Test func lookaheadErrorDoesNotDiscardTheFullBuffer() async throws {
+        struct ExpectedFailure: Error {}
+        let stream = AsyncThrowingStream<UInt8, any Error> { continuation in
+            for byte in UInt8(0) ..< UInt8(8) { continuation.yield(byte) }
+            continuation.finish(throwing: ExpectedFailure())
+        }
+        let reader = AsyncBytesDownloadStream(stream: AnyAsyncSequence(stream))
+
+        let fullBuffer = try await reader.read(upTo: 8)
+        #expect(fullBuffer.data == Data((0 ..< 8).map(UInt8.init)))
+        #expect(!fullBuffer.reachedEnd)
+        await #expect(throws: ExpectedFailure.self) {
+            _ = try await reader.read(upTo: 8)
+        }
+    }
+
+    @Test func exactSizeFileReportsEOFWithoutMutatingInitialOffset() async throws {
+        let url = FileManager.default.temporaryDirectory
+            .appendingPathComponent("ProtonDriveSDK-\(UUID().uuidString).bin")
+        defer { try? FileManager.default.removeItem(at: url) }
+        try Data((0 ..< 8).map(UInt8.init)).write(to: url)
+        let handle = try FileHandle(forReadingFrom: url)
+        try handle.seek(toOffset: 3)
+
+        let reader = FileHandleDownloadStream(fileHandle: handle)
+        #expect(try handle.offset() == 3)
+        let result = try await reader.read(upTo: 5)
+
+        #expect(result.data == Data((3 ..< 8).map(UInt8.init)))
+        #expect(result.reachedEnd)
+    }
+}
