@@ -0,0 +1,72 @@
+import Foundation
+import Testing
+@testable import ProtonDriveSDK
+
+@Suite("Callback registry cancellation")
+struct CallbackHandleRegistryTests {
+    @Test func cancellationRemovesHandleAndResumesExactlyOnce() {
+        let recorder = CompletionRecorder()
+        let box = BoxedCompletionBlock<Void, Void>({ recorder.record($0) }, state: ())
+        let handle = CallbackHandleRegistry.shared.register(box)
+        box.registryHandleId = handle
+
+        CallbackHandleRegistry.shared.cancel(handle)
+        CallbackHandleRegistry.shared.cancel(handle)
+
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+        #expect(recorder.count == 1)
+        #expect(recorder.wasCancelled)
+        #expect(CallbackHandleRegistry.shared.get(handle, as: BoxedCompletionBlock<Void, Void>.self) == nil,
+                "a late yield/terminal callback must become a no-op")
+    }
+
+    @Test func cancellationAndTerminalCompletionRaceStillResumeOnce() async {
+        let recorder = CompletionRecorder()
+        let box = BoxedCompletionBlock<Void, Void>({ recorder.record($0) }, state: ())
+        let handle = CallbackHandleRegistry.shared.register(box)
+        box.registryHandleId = handle
+
+        await withTaskGroup(of: Void.self) { group in
+            group.addTask { CallbackHandleRegistry.shared.cancel(handle) }
+            group.addTask {
+                (CallbackHandleRegistry.shared.remove(handle) as? BoxedCompletionBlock<Void, Void>)?
+                    .resume(returning: ())
+            }
+        }
+
+        #expect(recorder.count == 1)
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+    }
+
+    @Test func cancellationBeforeHandleInstallationCancelsTheLateRegistration() {
+        let recorder = CompletionRecorder()
+        let box = BoxedCompletionBlock<Void, Void>({ recorder.record($0) }, state: ())
+        let handle = CallbackHandleRegistry.shared.register(box)
+        box.registryHandleId = handle
+        let cancellation = SDKRequestHandler.RequestCancellation()
+
+        cancellation.cancel()
+        cancellation.install(handle)
+
+        #expect(!CallbackHandleRegistry.shared.contains(handle))
+        #expect(recorder.count == 1)
+        #expect(recorder.wasCancelled)
+    }
+}
+
+private final class CompletionRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var results: [Result<Void, Error>] = []
+
+    func record(_ result: Result<Void, Error>) {
+        lock.withLock { results.append(result) }
+    }
+
+    var count: Int { lock.withLock { results.count } }
+    var wasCancelled: Bool {
+        lock.withLock {
+            guard case let .failure(error)? = results.first else { return false }
+            return error is CancellationError
+        }
+    }
+}
