+        state: State,
+        scope: CallbackScope = .operation,
+        owner: (any AnyObject & Sendable)? = nil
+    ) async throws -> Response {
+        let tokenSource = try await CancellationTokenSource(logger: logger)
+        let cancellationState = EventEnumerationCancellationState(tokenSource: tokenSource)
+        activeEnumerations[identifier] = cancellationState
+        do {
+            let response: Response = try await SDKRequestHandler.sendCancellable(
+                makeRequest(tokenSource.handle), state: state, scope: scope, owner: owner,
+                requestCancellation: cancellationState.requestCancellation, logger: logger)
+            await releaseEnumeration(identifier: identifier, state: cancellationState, cancellationRequested: false)
+            return response
+        } catch is CancellationError {
+            await releaseEnumeration(identifier: identifier, state: cancellationState, cancellationRequested: true)
+            throw CancellationError()
+        } catch {
+            await releaseEnumeration(identifier: identifier, state: cancellationState, cancellationRequested: false)
+            throw error
+        }
+    }
