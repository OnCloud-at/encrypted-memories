--- a/Sources/Plumbing/SDKRequestHandler.swift
+++ b/Sources/Plumbing/SDKRequestHandler.swift
@@ -11,0 +12,38 @@ enum SDKRequestHandler {
+        private var isDispatching = false
+        private var hasDispatched = false
+        private var dispatchWaiters: [CheckedContinuation<Void, Never>] = []
+
+        var hasPendingDispatchWaiter: Bool {
+            lock.withLock { !dispatchWaiters.isEmpty }
+        }
+
+        /// No native request may start after cancellation has released its token.
+        func beginDispatch() -> Bool {
+            lock.withLock {
+                guard !isCancelled, !hasDispatched else { return false }
+                hasDispatched = true
+                isDispatching = true
+                return true
+            }
+        }
+
+        func endDispatch() {
+            let waiters = lock.withLock { () -> [CheckedContinuation<Void, Never>] in
+                isDispatching = false
+                let waiters = dispatchWaiters
+                dispatchWaiters.removeAll()
+                return waiters
+            }
+            for waiter in waiters { waiter.resume() }
+        }
+
+        func waitForDispatch() async {
+            await withCheckedContinuation { continuation in
+                let shouldResume = lock.withLock {
+                    guard isDispatching else { return true }
+                    dispatchWaiters.append(continuation)
+                    return false
+                }
+                if shouldResume { continuation.resume() }
+            }
+        }
@@ -114,0 +153,6 @@ enum SDKRequestHandler {
+                if Task.isCancelled { requestCancellation.cancel() }
+                guard requestCancellation.beginDispatch() else {
+                    continuation.resume(throwing: CancellationError())
+                    return
+                }
+                defer { requestCancellation.endDispatch() }
