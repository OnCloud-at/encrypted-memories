diff --git a/Tests/DriveEventEnumerationCallbackTests.swift b/Tests/DriveEventEnumerationCallbackTests.swift
index e799e98..ab83330 100644
--- a/Tests/DriveEventEnumerationCallbackTests.swift
+++ b/Tests/DriveEventEnumerationCallbackTests.swift
@@ -78,0 +79,24 @@ struct DriveEventEnumerationCallbackTests {
+    @Test func nativeTokenReleaseWaitsForRequestSubmission() async {
+        let lifecycle = LifecycleRecorder()
+        let cancellation = EventEnumerationCancellationState(
+            cancelNative: { lifecycle.append("cancel") },
+            freeNative: { lifecycle.append("free") }
+        )
+        #expect(cancellation.requestCancellation.beginDispatch())
+        let task = Task { await cancellation.cancelAndRelease() }
+
+        var didEnterWait = false
+        for _ in 0..<10_000 {
+            if cancellation.requestCancellation.hasPendingDispatchWaiter {
+                didEnterWait = true
+                break
+            }
+            await Task.yield()
+        }
+        #expect(didEnterWait)
+        #expect(lifecycle.values.isEmpty)
+        cancellation.requestCancellation.endDispatch()
+        await task.value
+        #expect(lifecycle.values == ["cancel", "free"])
+    }
+
