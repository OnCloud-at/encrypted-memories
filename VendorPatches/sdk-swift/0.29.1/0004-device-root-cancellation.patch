+        state: State,
+        scope: CallbackScope = .operation,
+        owner: (any AnyObject & Sendable)? = nil
+    ) async throws -> Response {
+        let tokenSource = try await CancellationTokenSource(logger: logger)
+        if Task.isCancelled {
+            await tokenSource.freeAndWait()
+            throw CancellationError()
+        }
+        let cancellationState = EventEnumerationCancellationState(tokenSource: tokenSource)
+        activeEnumerations[identifier] = cancellationState
