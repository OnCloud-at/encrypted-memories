@@ -52,0 +53,24 @@ struct CallbackHandleRegistryTests {
+    @Test func cancellationBeforeDispatchRejectsNativeSubmission() {
+        let cancellation = SDKRequestHandler.RequestCancellation()
+        cancellation.cancel()
+        #expect(!cancellation.beginDispatch())
+    }
+
+    @Test func cancellationDoesNotFinishWhileNativeSubmissionIsInProgress() async {
+        let cancellation = SDKRequestHandler.RequestCancellation()
+        let probe = DispatchCompletionProbe()
+        #expect(cancellation.beginDispatch())
+        cancellation.cancel()
+
+        let waiter = Task {
+            await probe.markStarted()
+            await cancellation.waitForDispatch()
+            await probe.markFinished()
+        }
+        while !(await probe.started) { await Task.yield() }
+        #expect(!(await probe.finished))
+        cancellation.endDispatch()
+        await waiter.value
+        #expect(await probe.finished)
+    }
+
@@ -73,0 +98,8 @@ private final class RegistryOwner {}
+private actor DispatchCompletionProbe {
+    private(set) var started = false
+    private(set) var finished = false
+
+    func markStarted() { started = true }
+    func markFinished() { finished = true }
+}
