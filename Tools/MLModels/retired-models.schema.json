{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.oncloud.at/schemas/retired-models-v1.json",
  "title": "Encrypted Memories retired model IDs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelIDs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modelIDs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z0-9]|[a-z0-9](?:[a-z0-9]|-(?!-)){0,126}[a-z0-9])$"
      }
    }
  }
}
