    },
    "search.suggestions_empty_description": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Sobald Fotos geladen sind, erscheinen hier passende Datumsvorschläge." } },
        "en": { "stringUnit": { "state": "translated", "value": "Date suggestions appear here after photos load." } }
      }
    },
