    "settings.albumsync_add_albums": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose albums…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Alben auswählen…" } }
      }
    },
    "settings.photos_backup_explainer": {
      "extractionState": "manual",
      "comment": "Shown BEFORE the system permission prompt - states plainly what enabling will do.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backs up your photos and videos to Proton Drive, encrypted. Your originals stay untouched, and nothing is ever deleted from your library. Photos that can be matched exactly are not uploaded again. If older remote photos lack the required metadata, backup continues with a warning. Turning this on needs access to your photos." } },
        "de": { "stringUnit": { "state": "translated", "value": "Sichert deine Fotos und Videos verschlüsselt in Proton Drive. Deine Originale bleiben unverändert, und es wird nie etwas aus deiner Mediathek gelöscht. Exakt erkennbare Fotos werden nicht noch mal hochgeladen. Fehlen bei älteren Remote-Fotos die nötigen Metadaten, läuft das Backup mit einer Warnung weiter. Zum Aktivieren braucht die App Zugriff auf deine Fotos." } }
      }
    },
    "settings.bug_report_action": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Report a bug" } },
        "de": { "stringUnit": { "state": "translated", "value": "Fehler melden" } }
      }
    },
    "settings.bug_report_instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Download the support file, then open Support. Describe the problem in GitHub Issues and attach the file." } },
        "de": { "stringUnit": { "state": "translated", "value": "Lade die Supportdatei herunter und öffne danach Support. Beschreibe den Fehler in GitHub Issues und hänge die Datei an." } }
      }
    },
    "settings.bug_report_download": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Download support file" } },
        "de": { "stringUnit": { "state": "translated", "value": "Supportdatei herunterladen" } }
