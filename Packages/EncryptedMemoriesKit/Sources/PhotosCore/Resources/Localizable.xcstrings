      }
    },
    "settings.bug_report_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The file contains app and performance state, but no filenames, photo identifiers, searches, paths, or photo contents. Review it before attaching it to a public issue." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Datei enthält App- und Leistungszustände, aber keine Dateinamen, Foto-IDs, Suchtexte, Pfade oder Fotoinhalte. Prüfe sie, bevor du sie an ein öffentliches Issue anhängst." } }
      }
    },
