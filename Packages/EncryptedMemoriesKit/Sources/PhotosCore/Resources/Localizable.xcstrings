    "mlsearch.privacy_note %@": {
      "extractionState": "manual",
      "comment": "Privacy statement shown in Smart Search settings.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%@ runs entirely on this device. Photos and search queries are never uploaded." } },
        "de": { "stringUnit": { "state": "translated", "value": "%@ verarbeitet Mediathekinhalte und Suchanfragen ausschließlich auf diesem Gerät." } }
      }
    },
    "mlsearch.native_search_intro": {
      "extractionState": "manual",
      "comment": "Explains the zero-download native search enabled by the main Smart Search switch.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your library is analyzed automatically on this device. Text, codes and additional image features are captured locally; no model download is required." } },
        "de": { "stringUnit": { "state": "translated", "value": "Deine Mediathek wird automatisch auf diesem Gerät analysiert. Text, Codes und weitere Bildmerkmale werden lokal erfasst; ein Modell-Download ist dafür nicht erforderlich." } }
      }
    },
    "mlsearch.visual_search_intro": {
      "extractionState": "manual",
      "comment": "Explains the independently optional downloadable visual search feature.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Optional. Adds natural-language search for objects, scenes and image content using a downloadable model." } },
        "de": { "stringUnit": { "state": "translated", "value": "Optional. Ergänzt die Suche nach Objekten, Szenen und Bildinhalten mit einem herunterladbaren Modell." } }
      }
    },
    "mlsearch.developer_model_note": {
      "extractionState": "manual",
      "comment": "Warning under developer-only models in the model picker.",
