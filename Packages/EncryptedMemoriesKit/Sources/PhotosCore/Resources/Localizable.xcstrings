      }
    },
    "library.curation_loading": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Mediathek wird kuratiert …" } },
        "en": { "stringUnit": { "state": "translated", "value": "Curating library …" } }
      }
    },
    "library.photo_singular": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "1 Foto" } },
        "en": { "stringUnit": { "state": "translated", "value": "1 photo" } }
      }
    },
    "library.photos_plural": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Fotos" } },
        "en": { "stringUnit": { "state": "translated", "value": "photos" } }
      }
    },
    "albums.add_failed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn’t add to album" } },
        "de": { "stringUnit": { "state": "translated", "value": "Hinzufügen nicht möglich" } }
      }
    },
    "error.favorite_update_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn’t update some favorites." } },
        "de": { "stringUnit": { "state": "translated", "value": "Einige Favoriten konnten nicht aktualisiert werden." } }
      }
    },
    "albums.add_selection_title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add to Album" } },
        "de": { "stringUnit": { "state": "translated", "value": "Zu Album hinzufügen" } }
      }
    },
    "albums.create_action": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Create" } },
        "de": { "stringUnit": { "state": "translated", "value": "Erstellen" } }
      }
    },
    "albums.create_add_footer %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The album will be created and %lld selected items will be added." } },
        "de": { "stringUnit": { "state": "translated", "value": "Das Album wird erstellt und %lld ausgewählte Objekte werden hinzugefügt." } }
      }
    },
    "albums.create_add_footer_one": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The album will be created and the selected item will be added." } },
        "de": { "stringUnit": { "state": "translated", "value": "Das Album wird erstellt und das ausgewählte Objekt wird hinzugefügt." } }
      }
    },
    "albums.create_and_add_action": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Create & Add" } },
        "de": { "stringUnit": { "state": "translated", "value": "Erstellen & hinzufügen" } }
      }
    },
    "albums.create_failed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn’t create album" } },
        "de": { "stringUnit": { "state": "translated", "value": "Album konnte nicht erstellt werden" } }
      }
    },
    "albums.create_new_action": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "New Album" } },
        "de": { "stringUnit": { "state": "translated", "value": "Neues Album" } }
      }
    },
    "albums.create_title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Create Album" } },
        "de": { "stringUnit": { "state": "translated", "value": "Album erstellen" } }
      }
    },
    "albums.existing_section": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Existing Albums" } },
        "de": { "stringUnit": { "state": "translated", "value": "Vorhandene Alben" } }
      }
    },
    "albums.failure_done": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OK" } },
        "de": { "stringUnit": { "state": "translated", "value": "OK" } }
      }
    },
    "albums.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Loading albums…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Alben werden geladen …" } }
      }
    },
    "albums.name_label": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Name" } },
        "de": { "stringUnit": { "state": "translated", "value": "Name" } }
      }
    },
    "albums.name_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Album name" } },
        "de": { "stringUnit": { "state": "translated", "value": "Albumname" } }
      }
    },
    "albums.none_available": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No albums yet" } },
        "de": { "stringUnit": { "state": "translated", "value": "Noch keine Alben" } }
      }
    },
    "albums.try_again": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Try Again" } },
        "de": { "stringUnit": { "state": "translated", "value": "Erneut versuchen" } }
      }
    },
    "error.album_created_add_failed %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The album “%@” was created, but the selected items could not be added. Select the album and try again." } },
        "de": { "stringUnit": { "state": "translated", "value": "Das Album „%@“ wurde erstellt, aber die ausgewählten Objekte konnten nicht hinzugefügt werden. Wähle das Album aus und versuche es erneut." } }
      }
    },
    "error.album_partial_add %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%1$lld of %2$lld items were added. Try again for the remaining items." } },
        "de": { "stringUnit": { "state": "translated", "value": "%1$lld von %2$lld Objekten wurden hinzugefügt. Versuche es für die übrigen Objekte erneut." } }
      }
    },
    "error.album_backend": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The album could not be updated. Try again." } },
        "de": { "stringUnit": { "state": "translated", "value": "Das Album konnte nicht aktualisiert werden. Versuche es erneut." } }
      }
    },
    "backup.detail_already_backed_up %lld": {
      "extractionState": "manual",
      "comment": "Completed-state detail: how many items were already safe and skipped without uploading.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Already backed up: %lld" } },
        "de": { "stringUnit": { "state": "translated", "value": "Bereits gesichert: %lld" } }
      }
    },
    "backup.detail_attention %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%lld files not backed up yet" } },
        "de": { "stringUnit": { "state": "translated", "value": "%lld Dateien noch nicht gesichert" } }
      }
    },
    "backup.detail_backed_up %lld %lld": {
      "extractionState": "manual",
      "comment": "Uploading-state detail. First %lld: proven backed-up count, second: total considered.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%lld of %lld backed up" } },
        "de": { "stringUnit": { "state": "translated", "value": "%lld von %lld gesichert" } }
      }
    },
    "backup.detail_checked %lld %lld": {
      "extractionState": "manual",
      "comment": "Checking-state detail. Deliberately 'checked', never 'uploaded' or 'hashed'.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%lld of %lld checked" } },
        "de": { "stringUnit": { "state": "translated", "value": "%lld von %lld geprüft" } }
      }
    },
    "backup.detail_preparing_index %lld %lld": {
      "extractionState": "manual",
      "comment": "Progress while the encrypted remote duplicate index is prepared before item checks.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Preparing backup index: %lld of %lld" } },
        "de": { "stringUnit": { "state": "translated", "value": "Sicherungsindex wird vorbereitet: %lld von %lld" } }
      }
    },
    "backup.detail_preparing_index_indeterminate": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Preparing backup index…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Sicherungsindex wird vorbereitet…" } }
      }
    },
    "backup.detail_preparing_index_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The backup index could not be prepared. Try again later." } },
        "de": { "stringUnit": { "state": "translated", "value": "Der Sicherungsindex konnte nicht vorbereitet werden. Versuche es später erneut." } }
      }
    },
    "backup.warning_dedupe_degraded %lld": {
      "extractionState": "manual",
      "comment": "Non-blocking warning when legacy remote photos lack encrypted exact-content hashes.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%lld existing photos could not be checked for exact duplicates. Backup continues and may create duplicates." } },
        "de": { "stringUnit": { "state": "translated", "value": "%lld vorhandene Fotos konnten nicht auf exakte Duplikate geprüft werden. Das Backup läuft weiter und kann Duplikate erzeugen." } }
      }
    },
    "backup.detail_waiting %lld": {
      "extractionState": "manual",
      "comment": "Waiting-state detail: outstanding items that continue on the next run.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%lld files will continue on the next run" } },
        "de": { "stringUnit": { "state": "translated", "value": "%lld Dateien werden beim nächsten Durchlauf fortgesetzt" } }
      }
    },
    "backup.error_background_immediate_ineligible": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "iOS could not continue this backup immediately. A later background attempt remains scheduled." } },
        "de": { "stringUnit": { "state": "translated", "value": "iOS konnte diese Sicherung nicht sofort fortsetzen. Ein späterer Hintergrundversuch bleibt geplant." } }
      }
    },
    "backup.error_background_not_permitted": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "iOS has not permitted background backup. Check Background App Refresh in Settings or keep Encrypted Memories open." } },
        "de": { "stringUnit": { "state": "translated", "value": "iOS hat die Hintergrundsicherung nicht erlaubt. Prüfe die Hintergrundaktualisierung in den Einstellungen oder lasse Encrypted Memories geöffnet." } }
      }
    },
    "backup.error_background_refresh_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Background backup is unavailable. Enable Background App Refresh in Settings or keep Encrypted Memories open." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Hintergrundsicherung ist nicht verfügbar. Aktiviere die Hintergrundaktualisierung in den Einstellungen oder lasse Encrypted Memories geöffnet." } }
      }
    },
    "backup.error_background_registration": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Background backup could not be registered. Restart Encrypted Memories; keep it open until backup completes." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Hintergrundsicherung konnte nicht registriert werden. Starte Encrypted Memories neu und lasse die App bis zum Abschluss geöffnet." } }
      }
    },
    "backup.error_background_scheduler_capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The iOS background queue is currently full. Encrypted Memories will retry; keep the app open to continue now." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die iOS-Hintergrundwarteschlange ist derzeit voll. Encrypted Memories versucht es erneut; lasse die App geöffnet, um jetzt fortzufahren." } }
      }
    },
    "backup.error_background_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Background backup could not be scheduled. Encrypted Memories will retry; keep the app open to continue now." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Hintergrundsicherung konnte nicht geplant werden. Encrypted Memories versucht es erneut; lasse die App geöffnet, um jetzt fortzufahren." } }
      }
    },
    "backup.phase_attention": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Some files were not backed up" } },
        "de": { "stringUnit": { "state": "translated", "value": "Einige Dateien wurden nicht gesichert" } }
      }
    },
    "backup.phase_checking": {
      "extractionState": "manual",
      "comment": "Headline while proving items are already backed up (identity + duplicate check). NEVER worded as uploading or hashing - a user whose library already lives in Proton (e.g. synced via the official Drive app) must read this as verification, not as a re-upload.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Checking what’s already backed up" } },
        "de": { "stringUnit": { "state": "translated", "value": "Es wird geprüft, was bereits gesichert ist" } }
      }
    },
    "backup.phase_completed": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "All files backed up" } },
        "de": { "stringUnit": { "state": "translated", "value": "Alle Dateien gesichert" } }
      }
    },
    "backup.phase_completed_with_omissions": {
      "extractionState": "manual",
      "comment": "Calm terminal state after the user acknowledged permanent items that remain not backed up. Never claims all files are safe.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup finished" } },
        "de": { "stringUnit": { "state": "translated", "value": "Sicherung abgeschlossen" } }
      }
    },
    "backup.phase_completed_with_remote_deletions": {
      "extractionState": "manual",
      "comment": "Successful terminal backup state when all eligible items are backed up and exact-content items deliberately deleted in Proton were not recreated.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup complete" } },
        "de": { "stringUnit": { "state": "translated", "value": "Sicherung abgeschlossen" } }
      }
    },
    "backup.phase_idle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ready" } },
        "de": { "stringUnit": { "state": "translated", "value": "Bereit" } }
      }
    },
    "backup.phase_paused": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paused" } },
        "de": { "stringUnit": { "state": "translated", "value": "Pausiert" } }
      }
    },
    "backup.phase_scanning": {
      "extractionState": "manual",
      "comment": "Headline while enumerating folders/assets. Totals are unknown - UI shows an indeterminate spinner.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Looking for files…" } },
        "de": { "stringUnit": { "state": "translated", "value": "Dateien werden gesucht…" } }
      }
    },
    "backup.phase_uploading": {
      "extractionState": "manual",
      "comment": "Headline ONLY while bytes are actually uploading.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backing up" } },
        "de": { "stringUnit": { "state": "translated", "value": "Wird gesichert" } }
      }
    },
    "backup.phase_waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Backup incomplete" } },
        "de": { "stringUnit": { "state": "translated", "value": "Backup unvollständig" } }
      }
    },
    "backup.phase_waiting_network": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Waiting for a stable connection" } },
        "de": { "stringUnit": { "state": "translated", "value": "Warten auf eine stabile Verbindung" } }
      }
    },
    "backup.phase_waiting_storage": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Device storage needed" } },
        "de": { "stringUnit": { "state": "translated", "value": "Gerätespeicher benötigt" } }
      }
    },
    "backup.phase_waiting_draft": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Waiting for Proton to finish pending uploads" } },
        "de": { "stringUnit": { "state": "translated", "value": "Warten auf ausstehende Proton-Uploads" } }
      }
    },
    "backup.detail_retry_at %@": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Next attempt at %@" } },
        "de": { "stringUnit": { "state": "translated", "value": "Nächster Versuch um %@" } }
      }
    },
    "backup.issue_network": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The connection was interrupted. Backup will retry when eligible." } },
        "de": { "stringUnit": { "state": "translated", "value": "Die Verbindung wurde unterbrochen. Das Backup versucht es erneut, sobald es möglich ist." } }
      }
    },
    "backup.issue_device_storage": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Not enough free space on this device to prepare the original." } },
        "de": { "stringUnit": { "state": "translated", "value": "Auf diesem Gerät ist nicht genug freier Speicher zum Vorbereiten des Originals vorhanden." } }
      }
    },
    "backup.issue_remote_draft": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "An incomplete upload in Proton currently blocks this item." } },
        "de": { "stringUnit": { "state": "translated", "value": "Ein unvollständiger Upload in Proton blockiert dieses Objekt derzeit." } }
      }
    },
    "backup.issue_remote_draft_stale": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "An incomplete Proton upload kept blocking this item after repeated checks. You can dismiss this warning without marking the item as backed up." } },
        "de": { "stringUnit": { "state": "translated", "value": "Ein unvollständiger Proton-Upload blockiert dieses Objekt auch nach wiederholten Prüfungen. Du kannst die Warnung ausblenden, ohne das Objekt als gesichert zu markieren." } }
      }
    },
    "backup.issue_permission": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Encrypted Memories no longer has permission to read this item." } },
        "de": { "stringUnit": { "state": "translated", "value": "Encrypted Memories darf dieses Objekt nicht mehr lesen." } }
      }
    },
    "backup.issue_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This item uses an unsupported resource format." } },
        "de": { "stringUnit": { "state": "translated", "value": "Dieses Objekt verwendet ein nicht unterstütztes Ressourcenformat." } }
      }
    },
    "backup.issue_remote_service": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Proton could not complete this operation. The recorded server detail is shown below." } },
        "de": { "stringUnit": { "state": "translated", "value": "Proton konnte diesen Vorgang nicht abschließen. Das gespeicherte Serverdetail wird unten angezeigt." } }
      }
    },
    "backup.error_low_space": {
      "extractionState": "manual",
      "comment": "Backup queue row error: the device is too low on free space to prepare the file for upload. Retryable, never permanent; shown in diagnostics/bug reports.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough space on this device to prepare the file"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Speicher auf diesem Gerät, um die Datei vorzubereiten"
          }
        }
      }
    },
    "backup.error_local_state_unavailable": {
      "extractionState": "manual",
      "comment": "Backup cannot continue safely because its local persistent queue is unavailable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup cannot continue safely because its local state is unavailable. Please restart the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup kann nicht sicher fortgesetzt werden, weil der lokale Status nicht verfügbar ist. Bitte starte die App neu."
          }
        }
      }
    },
    "backup.error_execution_lock_unavailable": {
      "extractionState": "manual",
      "comment": "Backup cannot start safely because the local execution lock store is unavailable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup cannot start safely right now. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup kann gerade nicht sicher gestartet werden. Bitte versuche es erneut."
          }
        }
      }
    },
    "backup.error_source_missing": {
      "extractionState": "manual",
      "comment": "Backup queue row error: the local source file disappeared before it could be backed up.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file no longer exists on this device"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist auf diesem Gerät nicht mehr vorhanden"
          }
        }
      }
    },
    "backup.detail_respected_remote_deletions %lld": {
      "extractionState": "manual",
      "comment": "Informational completed-backup detail. Proton proved these exact files existed and were deleted there, so automatic backup deliberately did not recreate them.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld previously backed-up items were not recreated because they were deleted in Proton Drive"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld früher gesicherte Objekte wurden nicht erneut angelegt, da sie in Proton Drive gelöscht wurden"
          }
        }
      }
    },
    "backup.remote_deletions_info_title": {
      "extractionState": "manual",
      "comment": "Title of the informational dialog explaining why previously backed-up items deleted in Proton are not recreated.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recreated"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erneut angelegt"
          }
        }
      }
    },
    "backup.state_skipped_remote_deletion": {
      "extractionState": "manual",
      "comment": "Backup queue row note: Proton proved the identical photo existed and is now trashed or deleted, so it is deliberately not re-uploaded.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped: deleted in Proton Drive"
