    "settings.upload_check_idle_help": {
      "extractionState": "manual",
      "comment": "Explains that files are checked before upload and duplicates are skipped.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before uploading, the app checks whether a photo is already backed up. If it is, it’s skipped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Hochladen prüft die App, ob ein Foto schon gesichert ist. Falls ja, wird es übersprungen."
          }
        }
      }
    },
    "settings.upload_check_progress %lld %lld": {
