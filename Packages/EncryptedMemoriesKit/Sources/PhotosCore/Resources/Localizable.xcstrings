{
  "sourceLanguage": "en",
  "strings": {
    "search.title": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Suchen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Search" } }
      }
    },
    "search.recent": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Zuletzt" } },
        "en": { "stringUnit": { "state": "translated", "value": "Recent" } }
      }
    },
    "search.clear": {
